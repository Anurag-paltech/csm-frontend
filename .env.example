# API base URL. Empty = root-relative (same origin as the app), which the BFF
# expects. Set an absolute URL only if the API is served from a different origin
# (then the backend must send CORS + credentials).
VITE_API_BASE_URL=

# Backend origin for the dev proxy. The BFF serves everything at root
# (/me, /auth/*, /claims, /admin/*, /health). See vite.config.js.
VITE_DEV_API_PROXY=http://localhost:8000

# --- Development only ------------------------------------------------------
# Skip authentication entirely and run as a mock user. Has NO effect in a
# production build (guarded by import.meta.env.DEV). Only needed when the auth
# backend is unreachable.
# VITE_AUTH_BYPASS=true
#
# Roles granted to the bypass user (comma-separated). Default: admin,user_business
# Set to just "user_business" to exercise the admin route guard (403).
# VITE_AUTH_BYPASS_ROLES=admin,user_business
